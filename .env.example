# PostgreSQL
POSTGRES_PASSWORD=sua_senha_do_banco
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gestao_db
DB_USER=gestao_user
DB_PASSWORD=sua_senha_do_banco
DB_HOST=127.0.0.1
DB_PORT=5434

# Django
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque_por_uma_chave_secreta_unica
DEBUG=False
# Hosts permitidos, separados por virgula (ex: app.seudominio.com.br,.seudominio.com.br)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiaveis para CSRF (separadas por virgula, com esquema http(s)://)
# CSRF_TRUSTED_ORIGINS=https://app.seudominio.com.br
# Desligar apenas se o proxy/tunnel já força HTTPS antes de chegar no Django
SECURE_SSL_REDIRECT=True

# Redis (cache + channel layer). Sem isso, cai em fallback local (locmem / in-memory).
REDIS_HOST=
REDIS_CACHE_URL=

# Email (Resend SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_sua_chave_api_resend
DEFAULT_FROM_EMAIL=noreply@seudominio.com.br
# Destinatario do resumo diario (core/management/commands/enviar_resumo_diario.py)
EMAIL_ADMIN_RECEIVER=admin@seudominio.com.br

# Backup (django-dbbackup + Google Cloud Storage)
# Caminho da service account key. Opcional em dev (obrigatorio em producao).
GOOGLE_DRIVE_KEY_PATH=google_drive_key.json

# Notificacoes de backup no Discord (webhook do canal). Deixe em branco para
# desativar — backup_gcs.sh e verificar_saude_backup.sh pulam o aviso se
# esta variavel estiver vazia. Criar em: Discord > canal > Editar Canal >
# Integracoes > Webhooks > Novo Webhook > Copiar URL do Webhook.
DISCORD_WEBHOOK_URL=
